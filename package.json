{
  "name": "portfolio-api",
  "version": "1.0.0",
  "description": "Portfolio API for travello_db",
  "main": "portfolio-api.js",
  "scripts": {
    "start": "node portfolio-api.js",
    "dev": "nodemon portfolio-api.js",
    "migrate:blog": "node migrate-blog-data.js",
    "migrate:blog:file": "node migrate-blog-data.js --from-file",
    "migrate:blog:merge": "node migrate-blog-data.js --from-file --merge",
    "migrate:blog:clear": "node migrate-blog-data.js --clear-only",
    "migrate:blog:help": "node migrate-blog-data.js --help",
    "migrate:blog:dynamic": "node extract-dynamic-blog-data.js",
    "extract:browser": "node extract-dynamic-blog-data.js --browser-script"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mysql2": "^3.6.0",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
